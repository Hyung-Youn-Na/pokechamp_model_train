#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
runtime_python="$repo_root/.tools/openai-decisions/.venv/bin/python"
if [[ ! -x "$runtime_python" ]]; then
  echo "환경 설치 필요: bash $repo_root/integration/openai_decisions/setup.sh" >&2
  exit 1
fi
export PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}"
exec "$runtime_python" -m integration.openai_decisions "$@"
