export CUDA_VISIBLE_DEVICES=""
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
exec /ref/kev/.venv/bin/python -m integration.pokechamp.rule_qa_training.cli "$@"
