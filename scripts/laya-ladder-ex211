#!/usr/bin/env bash
# EX-211 (EP-243): EX-208 model (EX-200 + v13 + online MCTS 5k + EX-207 V_phi, 2-B) on the official Showdown gen9ou
# ladder until STOP_UTC (default 2026-11-24T04:00:00Z = 2026-11-24 13:00 KST), pinned strictly to physical GPU 1 ONLY
# (GPUs 2 and 3 are reserved for another project; GPU 0 runs EX-210). One game at a time on nhy_test1629.
main() {
set -u
ROOT=/workspace
PKG=/workspace/exports/laya-play
LAYA_PY="$ROOT/.tools/laya-0.4.13/worktrees/pokemon-training/.venv/bin/python"
LAYA_SRC="$ROOT/.tools/laya-0.4.13/worktrees/pokemon-v10"
STOP_UTC=${STOP_UTC:-2026-11-24T04:00:00Z}
TEAM=${TEAM:-t95bfb45561}
CKPT=/mnt/digicap/combined/hyna/backup/pokechamp-research/runs/model-training/EX-200/checkpoints/selected
VAL_CKPT=/mnt/digicap/combined/hyna/backup/pokechamp-research/runs/model-training/EX-207/checkpoints/selected
GPU1_UUID=GPU-c7e2d577-573f-0412-1ed6-ad6648efa454
READY=$PKG/runtime/serving-search2b.ready.json
stop=$(date -u -d "$STOP_UTC" +%s)
kst() { TZ=UTC-9 date '+%H:%M:%S KST'; }
cd "$PKG"
mkdir -p "$PKG/runtime/logs"
pgrep -f "laya_play.bot .*--name nhy_test1629" >/dev/null && { echo "[loop] $(kst) the account is in use; stopping"; exit 1; }
rm -f "$READY"
CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES="$GPU1_UUID" \
  OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 \
  PYTHONPATH="$LAYA_SRC:$ROOT:$ROOT/pokechamp" \
  PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
  "$LAYA_PY" -m integration.laya_search.serve_search \
  --checkpoint "$CKPT" --value-checkpoint "$VAL_CKPT" \
  --model laya-search2b --device cuda --workers 2 \
  --ready-file "$READY" >> "$PKG/runtime/logs/serving-search2b.log" 2>&1 < /dev/null &
SERVING_PID=$!
SERVICE=$PKG/runtime/serving.ready.json
[ -f "$SERVICE" ] && cp -p "$SERVICE" "$SERVICE.before-ex211"
trap 'kill "$SERVING_PID" 2>/dev/null; [ -f "$SERVICE.before-ex211" ] && mv -f "$SERVICE.before-ex211" "$SERVICE"' EXIT
for i in $(seq 300); do [ -f "$READY" ] && break; kill -0 $SERVING_PID 2>/dev/null || { echo "[loop] $(kst) serving died"; exit 1; }; sleep 1; done
[ -f "$READY" ] || { echo "[loop] $(kst) serving not ready"; exit 1; }
cp -f "$READY" "$SERVICE"
echo "[loop] $(kst) EX-211 search2b (EX-200 + v13 + MCTS 5k + EX-207 V_phi) serving pid $SERVING_PID on GPU 1 ready; loop until $STOP_UTC, team $TEAM"
fails=0 n=0
while :; do
  left=$(( (stop - $(date -u +%s)) / 60 ))
  (( left >= 1 )) || { echo "[loop] $(kst) stop time reached after run $n"; break; }
  kill -0 "$SERVING_PID" 2>/dev/null || { echo "[loop] $(kst) serving exited; stopping"; break; }
  mins=$(( left < 30 ? left : 30 ))
  n=$((n + 1))
  echo "[loop] $(kst) run $n: search2b (EX-208), search up to $mins min, team $TEAM"
  LADDER=yes SEARCH_MINUTES=$mins ./official.sh --games-limit 1 --team "$TEAM" --serving "$READY" 2>&1 \
      | grep -viE --line-buffered "password|assertion" \
      | grep -E --line-buffered "^\[bot\]|^\[official\] error|Traceback|Error"
  rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    fails=$((fails + 1)); echo "[loop] $(kst) run $n exited $rc (consecutive failures $fails)"
    (( fails >= 3 )) && { echo "[loop] $(kst) stopping after 3 consecutive failures"; break; }
    sleep 30
  else
    fails=0
  fi
  PYTHONPATH=app PYTHONDONTWRITEBYTECODE=1 python3 -m laya_play.ladder_replays --user nhy_test1629 2>&1 | tail -1
  sleep 5
done
echo "[loop] $(kst) done"
}
main "$@"; exit $?
