#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd -- "$script_dir/.." && pwd)"
export PYTHONPATH="$workspace_root:$workspace_root/pokechamp${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONHASHSEED=20261001 CUDA_VISIBLE_DEVICES=''
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
cd "$workspace_root/pokechamp"
exec "$workspace_root/pokechamp/.venv/bin/python" -m integration.pokechamp.kev_continuation "$@"
