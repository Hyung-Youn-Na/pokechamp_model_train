#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd -- "$script_dir/.." && pwd)"
export PYTHONPATH="$workspace_root:$workspace_root/pokechamp:/ref/quyet/src"
export POKECHAMP_WORKSPACE_ROOT="$workspace_root"
export PYTHONDONTWRITEBYTECODE=1
export TOKENIZERS_PARALLELISM=false
model_python="$workspace_root/.pokechamp-data/jev27b-runtime/.venv/bin/python"
actor_python="$workspace_root/pokechamp/.venv/bin/python"
cd "$workspace_root"
command="${1:---help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$command" in
  download|serve)
    module="$command"
    if [[ "$command" == serve ]]; then module=server; fi
    exec "$model_python" -m "integration.quyet.$module" "$@" ;;
  execute|prepare|finalize|status)
    exec "$actor_python" -m integration.quyet.execute "$command" "$@" ;;
  verify-browser)
    exec /tmp/ep037/tools/bin/python -m integration.quyet.viewer verify-browser "$@" ;;
  --help|-h) echo 'usage: scripts/quyet {download|prepare|serve|execute|finalize|status|verify-browser} [arguments]' ;;
  *) echo "unknown Quyet command: $command" >&2; exit 2 ;;
esac
