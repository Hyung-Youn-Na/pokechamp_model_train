#!/usr/bin/env bash
# EX-203 (EP-239): v12 engine-value (EX-200 selected) on the official Showdown gen9ou ladder until STOP_UTC, GPU 3 serving,
# laya-play official.sh one game at a time (one account). The serving stops with the loop (EXIT trap).
main() {
set -u
PKG=/workspace/exports/laya-play
STOP_UTC=${STOP_UTC:-2026-11-22T23:00:00Z}
TEAM=${TEAM:-t95bfb45561}
CKPT=/mnt/digicap/combined/hyna/backup/pokechamp-research/runs/model-training/EX-200/checkpoints/selected
READY=$PKG/runtime/serving-v12value.ready.json
stop=$(date -u -d "$STOP_UTC" +%s)
kst() { TZ=UTC-9 date '+%H:%M:%S KST'; }
cd "$PKG"
pgrep -f "laya_play.bot .*--name nhy_test1629" >/dev/null && { echo "[loop] $(kst) the account is in use; stopping"; exit 1; }
rm -f "$READY"
CUDA_VISIBLE_DEVICES=3 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONPATH=$PKG/app/laya-v10-src:$PKG/app \
  PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
  env/laya/bin/python -m integration.laya_v11.serve --checkpoint "$CKPT" --model laya-v12 --device cuda \
  --ready-file "$READY" >> runtime/logs/serving-v12value.log 2>&1 < /dev/null &
SERVING_PID=$!
# official.sh checks /health on runtime/serving.ready.json (not on --serving): point it at this serving while the
# loop runs and put the previous file back afterwards (it named the stopped v10rt laya-play service).
SERVICE=$PKG/runtime/serving.ready.json
[ -f "$SERVICE" ] && cp -p "$SERVICE" "$SERVICE.before-ex203"
trap 'kill "$SERVING_PID" 2>/dev/null; [ -f "$SERVICE.before-ex203" ] && mv -f "$SERVICE.before-ex203" "$SERVICE"' EXIT
for i in $(seq 300); do [ -f "$READY" ] && break; kill -0 $SERVING_PID 2>/dev/null || { echo "[loop] $(kst) serving died"; exit 1; }; sleep 1; done
[ -f "$READY" ] || { echo "[loop] $(kst) serving not ready"; exit 1; }
cp -f "$READY" "$SERVICE"
echo "[loop] $(kst) EX-203 v12value (EX-200) serving pid $SERVING_PID on GPU 3 ready; loop until $STOP_UTC, team $TEAM"
fails=0 n=0
while :; do
  left=$(( (stop - $(date -u +%s)) / 60 ))
  (( left >= 1 )) || { echo "[loop] $(kst) stop time reached after run $n"; break; }
  kill -0 "$SERVING_PID" 2>/dev/null || { echo "[loop] $(kst) serving exited; stopping"; break; }
  mins=$(( left < 30 ? left : 30 ))
  n=$((n + 1))
  echo "[loop] $(kst) run $n: v12value, search up to $mins min, team $TEAM"
  LADDER=yes SEARCH_MINUTES=$mins ./official.sh --games-limit 1 --team "$TEAM" --serving "$READY" 2>&1 \
      | grep -viE --line-buffered "password|assertion" \
      | grep -E --line-buffered "^\[bot\]|^\[official\] error|Traceback|Error"
  rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    fails=$((fails + 1)); echo "[loop] $(kst) run $n exited $rc (consecutive failures $fails)"
    (( fails >= 3 )) && { echo "[loop] $(kst) stopping after 3 consecutive failures"; break; }
    sleep 30
  else
    fails=0
  fi
  PYTHONPATH=app PYTHONDONTWRITEBYTECODE=1 python3 -m laya_play.ladder_replays --user nhy_test1629 2>&1 | tail -1
  sleep 5
done
echo "[loop] $(kst) done"
}
main "$@"; exit $?
