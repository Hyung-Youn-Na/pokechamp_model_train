#!/usr/bin/env bash
# EP-224 reserved lane (EX-156, user instruction 2026-11-02) on GPU1 / 8109: once EX-153 (the GPU1 lane's battle) and
# EX-155 (v8l training, GPU2 lane) are both completed, v8t vs v8lt on the EX-120 schedule against Abyssal:
# mock -> battle-window marker -> prepare/execute/export -> marker removed -> viewer check. A separate file so the running
# `laya-imitation-ep224` / `-ep224b` lanes are never edited. Stops at the first failing stage; nothing is re-run.
set -euo pipefail
cd /workspace
RUN=/workspace/scripts/laya-imitation
RUNS=/mnt/digicap/combined/hyna/backup/pokechamp-research/runs/model-training
EVIDENCE=/workspace/project_context/exec-plans/evidence/ep224
CHECK_PY=/tmp/ep037/tools/bin/python
WINDOW=/workspace/.pokechamp-data/battle-window
stage() { echo "[$(date -u +%FT%TZ)] $*"; }
completed() {   # completed <run dir>: status.json says completed
  [ -f "$1/status.json" ] && grep -q '"stage": *"completed"' "$1/status.json"
}
mock_ok() {     # mock_ok <run dir>: every mock game completed with a passed audit
  PYTHONPATH=/workspace python3 -c "
import json, sys
d = json.load(open(sys.argv[1] + '/mock/result.json'))
ok = d['phase_error'] is None and d['outcomes'] and all(o['status'] == 'completed' and o.get('audit_passed') for o in d['outcomes'])
print('mock', [(o['slot_id'], o['status'], o.get('result'), o.get('audit_passed')) for o in d['outcomes']], d['phase_error'])
sys.exit(0 if ok else 1)" "$1"
}
viewer_check() {
  mkdir -p "$EVIDENCE"
  if [ -x "$CHECK_PY" ]; then
    PYTHONPATH=/workspace PYTHONDONTWRITEBYTECODE=1 "$CHECK_PY" -m integration.laya_imitation.browser_check \
      "/workspace/exports/battle_viewers/$1" "$EVIDENCE/$1-viewer-check.json" $2 \
      || stage "viewer check failed for $1 (battles unaffected; recorded)"
  else
    stage "no Playwright interpreter at $CHECK_PY; viewer check for $1 left to a manual run"
  fi
}
SHOWDOWN_STATE="config/chat-plugins/mafia-logs.json config/chat-plugins/seasons.json"
showdown_clean() {
  local dirty
  dirty=$(git -C /workspace/pokemon-showdown status --porcelain | awk '{print $2}' | sort)
  [ -z "$dirty" ] && return 0
  if [ -z "$(comm -23 <(echo "$dirty") <(tr ' ' '\n' <<<"$SHOWDOWN_STATE" | sort))" ]; then
    stage "restoring Showdown chat-plugin state files: $(echo $dirty)"
    git -C /workspace/pokemon-showdown checkout -- $SHOWDOWN_STATE
  else
    stage "pokemon-showdown has other uncommitted changes: $(echo $dirty)"; return 1
  fi
}
battle() {   # battle <experiment> <gpu> <run dir> <cli command...>
  local id=$1 gpu=$2 dir=$3 s
  shift 3
  showdown_clean
  stage "$* mock"; "$RUN" "$@" mock
  mock_ok "$dir" || { stage "$id mock failed; stopping before prepare"; return 1; }
  mkdir -p "$WINDOW"
  printf 'started %s\ngpu %s\nsession EP-224\n' "$(date -u +%FT%TZ)" "$gpu" > "$WINDOW/$id"
  stage "battle-window marker $WINDOW/$id"
  for s in prepare execute export; do
    showdown_clean
    stage "$* $s"; "$RUN" "$@" "$s"
  done
  rm -f "$WINDOW/$id"
  stage "battle-window marker removed: $id"
}

case "${1:-}" in
  gpu1)
    until completed "$RUNS/EX-153" && completed "$RUNS/EX-155"; do sleep 300; done
    stage "EX-153 and EX-155 completed"
    battle EX-156 1 "$RUNS/EX-156" compare15
    viewer_check ex156 "" ;;
  *) echo "usage: $0 gpu1" >&2; exit 2 ;;
esac
stage "EP-224 reserved lane $1 finished"
