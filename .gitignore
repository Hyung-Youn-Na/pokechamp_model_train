# Monorepo-wide ignores. Per-subtree ignores live in AgenticSTS/.gitignore.
# See also .gitattributes (export-ignore) and docs/release/release_exclusions.md.

# Runtime locks / pid files emitted by the agent during postrun (carry a host id + token).
*.postrun.lock
.postrun.lock
*.pid

# Locally-regenerated, non-redistributable game content (AGPL upstream / proprietary
# extracts). Mirrored here at monorepo scope so they cannot be re-added from any subtree.
AgenticSTS/data/knowledge/upstream/
AgenticSTS/data/knowledge/*_dll.json
AgenticSTS/data/knowledge/afflictions.json
AgenticSTS/data/knowledge/powers.json
AgenticSTS/data/knowledge/localization/
# Decompiled-derived game-mechanic index .md (internal command names + values from
# sts2.dll). Regenerated locally — see AgenticSTS/data/knowledge/README.md. The two
# hand-authored files (character_strategies.md, README.md) are kept and DO ship.
AgenticSTS/data/knowledge/*.md
!AgenticSTS/data/knowledge/character_strategies.md
!AgenticSTS/data/knowledge/README.md

# Dev-side staging area (pre-restructure metadata + machine identifiers).
paper/data_package_2026-05-20/

# Secrets / local env. Root .env is loaded by scripts/pokechamp-env.
.env
!.env.example
*.key

# PokéChamp qualification environment and generated evidence
.tools/
.artifacts/
# Optional default location for full-fidelity research bundles. The runtime still
# requires an explicit POKECHAMP_DATA_ROOT so logging is never enabled implicitly.
.pokechamp-data/
__pycache__/
.pytest_cache/

# Parent-owned pinned calculator dependencies are installed from its lockfile.
/integration/pokechamp/improved_io/calculator/node_modules/

# EP-135 research preservation: originals stay local; archives are external.
# No trailing slash: these paths are also ignored when linked in the L1-L5 worktree.
/exports
/export
/data/showdown-replays
/project_context/exec-plans/evidence/*
!/project_context/exec-plans/evidence/INDEX.md
