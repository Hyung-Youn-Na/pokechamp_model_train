# Local provider settings used by scripts/pokechamp-env.
# Copy this file to .env, keep permission 0600, and never commit the real value.
OLLAMA_API_KEY=
POKECHAMP_PROVIDER=zai
POKECHAMP_MODEL=glm-5.3-flash
ZAI_BASE_URL=
ZAI_API_KEY=

# 독립 JEV 클라이언트 설정. 배틀 공급자 선택과는 별개입니다.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest

# 독립 OpenAI Decisions API (scripts/openai-decisions)
OPENAI_API_KEY=
